# Set this to a persistent host directory outside the repository.
JUMPSTART_DATA_DIR=/path/to/jumpstart-3d-data

# Optional bounded local CAD-agent tool traces and preview images (off by default).
JUMPSTART_MCP_TRACE=0

# Optional network editor (make up-lan). Use your server LAN IP and HTTPS CAD origin.
# JUMPSTART_LAN_ADDRESS=192.168.1.200
# JUMPSTART_CAD_ORIGIN=https://cad.home.example.com
